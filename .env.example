# 복사해서 .env.local 로 쓰고 값을 채운다. .env.local 은 git에 올리지 않는다(.gitignore).
NEXT_PUBLIC_SUPABASE_URL=
# 서버 전용 키(RLS 우회) — 브라우저로 나가면 안 되므로 NEXT_PUBLIC_ 를 붙이지 않는다. 설정 순서는 scripts/supabase_rls.sql 머리말.
SUPABASE_SERVICE_ROLE_KEY=
# RLS를 켜기 전·시험용(mock) 서버에서만 쓰는 공개 키
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
POPBILL_LINKID=
POPBILL_SECRET=
POPBILL_CORPNUM=
POPBILL_SENDER_FAX=
# 로그인(둘 다 있어야 켜진다 — 없으면 로그인 없이 동작). 만드는 법은 scripts/make_auth_user.mjs 머리말.
AUTH_SECRET=
AUTH_USERS=

# ── 고객사 표지(A안: 고객사마다 따로 배포). 비워 두면 동산화스너로 동작한다(동산화스너 배포는 건드리지 말 것).
# NEXT_PUBLIC_ 값은 빌드할 때 박힌다 — 바꾸면 다시 빌드·배포해야 한다.
NEXT_PUBLIC_TENANT=            # 비움 또는 dongsan = 동산화스너 / custom = 다른 고객사
NEXT_PUBLIC_COMPANY_NAME=      # 예: ○○상사 (custom일 때)
NEXT_PUBLIC_COMPANY_DEPT=      # 헤더 부서 문구(선택)
NEXT_PUBLIC_COMPANY_TAGLINE=   # 한 줄 소개용 업종 문구(선택, 예: 전기자재)
NEXT_PUBLIC_COMPANY_ITEMS=     # 품목관리 안내 문구용 업종 품목(선택)
NEXT_PUBLIC_SEAL_PATH=         # 인쇄 양식 도장 그림 경로(예: /seal-acme.png, public/에 넣는다). 비우면 도장 없이 인쇄
